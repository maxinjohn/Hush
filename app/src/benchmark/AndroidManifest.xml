<!--
  The benchmark variant only. Declaring the app profileable is what lets the profile generator and
  Macrobenchmark capture a profile from it and compile it from the shell; a release build carries no
  such declaration and stays opaque to anything outside the app.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>

</manifest>
