<?xml version="1.0" encoding="utf-8"?>
<!-- Preview stand-in for the static launcher icon: the icon's own background colour with
     its adaptive foreground layered on top, since the real icon lives in mipmap/. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_static_background" />
    <item android:drawable="@drawable/ic_launcher_static_adaptive_foreground" />
</layer-list>
