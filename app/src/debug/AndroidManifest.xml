<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only components.

  The Waze Bridge repair spans two system dialogs, so proving the app's half of it needs a way in
  that does not involve a hand on the screen. This receiver is exported (adb has to reach it) and it
  exists in no build that ships: nothing outside `src/debug` can see it, and it refuses to act unless
  `BuildConfig.DEBUG`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".waze.WazeBridgeRepairDebugReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="app.hush.music.action.WAZE_REPAIR_DEBUG" />
            </intent-filter>
        </receiver>

        <!-- Navigation, driven from a shell:
               adb shell am start -a android.intent.action.VIEW -d "hush://route?to=settings/player/audio_sources"
             A settings screen can only be reached by hand otherwise, which puts an automated
             check of what it renders out of reach on a device nobody is holding - a car head
             unit, for instance. MainActivity also refuses the route unless BuildConfig.DEBUG,
             and this filter exists in no build that ships. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="route"
                    android:scheme="hush" />
            </intent-filter>
        </activity>

        <!-- SpotiFLAC source verification, driven from a shell. Verification on a device whose
             WebView is too old for Cloudflare can only be finished in a browser, so proving the
             route needs a way in that does not involve a tap on a car screen. -->
        <receiver
            android:name=".spotiflac.SpotiFLACDebugReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="app.hush.music.action.SPOTIFLAC_DEBUG" />
            </intent-filter>
        </receiver>

        <!-- Android Auto's browse tree, read from a shell. A car's library only exists once a head
             unit connects, so the tree this feature builds cannot otherwise be inspected on a
             phone. This connects the app's own MediaBrowser to its own MusicService - the same
             session and the same media ids a head unit receives - and writes what it returns to
             files/debug/auto-library.txt, next to the switches that produced it. -->
        <receiver
            android:name=".auto.AutoLibraryDebugReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="app.hush.music.action.AUTO_LIBRARY_DEBUG" />
            </intent-filter>
        </receiver>

        <!-- In-process Compose semantics probe. Broadcast the action
             app.hush.music.action.SEMANTICS_PROBE (extras: label, content-bottom), then read the
             report it writes to files/debug/semantics-probe.txt; scripts/semantics-probe.sh does
             both.

             On a OnePlus running Android 12, uiautomator sees the mini player and the bottom bars of
             this app and no node at all for the Home, Search or Library tab, while those screens
             render and respond normally - so nothing outside the app can read or drive them, and
             Settings cannot be reached by a script. Only the app's own process can say whether the
             content has semantics or the bridge is dropping them; scripts/semantics-probe.sh wraps
             this. The provider holds the resumed activity the probe has to read. -->
        <receiver
            android:name=".debug.SemanticsProbeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="app.hush.music.action.SEMANTICS_PROBE" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".debug.SemanticsProbeActivityRegistry"
            android:authorities="${applicationId}.semantics-probe"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>
